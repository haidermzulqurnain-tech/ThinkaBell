{
  "name": "thinkabell",
  "version": "1.0.0",
  "private": true,
  "description": "ThinkaBell deal alert and price tracking platform",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prepare:hostinger": "node scripts/prepare-hostinger.js",
    "build:standalone": "node scripts/build-standalone.js",
    "package:hostinger": "pnpm build:standalone && node scripts/prepare-hostinger.js",
    "verify:hostinger": "tsx scripts/verify-hostinger-deploy.ts",
    "simulate": "tsx scripts/simulate-pipeline.ts",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv": "^16.4.7",
    "happy-dom": "^15.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
