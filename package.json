{
  "name": "thinkabell",
  "version": "1.0.0",
  "private": true,
  "description": "ThinkaBell deal alert and price tracking platform",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@thinkabell/config": "workspace:*",
    "@thinkabell/database": "workspace:*"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "node scripts/verify-build-env.js && turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prepare:hostinger": "node scripts/prepare-hostinger.js",
    "build:standalone": "node scripts/verify-build-env.js && node scripts/build-standalone.js",
    "package:hostinger": "pnpm build:standalone && node scripts/prepare-hostinger.js",
    "verify:hostinger": "tsx scripts/verify-hostinger-deploy.ts",
    "db:apply": "tsx scripts/apply-schema.ts",
    "check:supabase": "tsx scripts/check-supabase-connection.ts",
    "simulate": "tsx scripts/simulate-pipeline.ts",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.11",
    "pg": "^8.15.6",
    "prettier": "^3.5.1",
    "turbo": "^2.10.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.6",
      "onFail": "warn"
    }
  }
}
