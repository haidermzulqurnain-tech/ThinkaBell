{
  "name": "thinkabell",
  "version": "1.0.0",
  "private": true,
  "description": "ThinkaBell deal alert and price tracking platform",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prepare:hostinger": "node scripts/prepare-hostinger.js",
    "simulate": "tsx scripts/simulate-pipeline.ts",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "dotenv": "^16.4.7",
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
