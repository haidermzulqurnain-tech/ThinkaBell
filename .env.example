# ===============================================
# ThinkaBell Environment Configuration Template
# Duplicate this file to .env.local for apps/web
# and .env for apps/jobs
# ===============================================

NODE_ENV=development
PORT=3000

# Application URL
NEXT_PUBLIC_APP_URL=https://thinkabell.click

# -----------------------------------------------
# 1. Supabase (Database & RLS)
# -----------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-facing Supabase variables for Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------
# 2. Amazon Product Advertising API (PA-API 5.0)
# -----------------------------------------------
AMAZON_ACCESS_KEY=your-amazon-access-key
AMAZON_SECRET_KEY=your-amazon-secret-key
AMAZON_PARTNER_TAG=thinkabell-20
AMAZON_REGION=us-east-1

# -----------------------------------------------
# 3. eBay Browse API
# -----------------------------------------------
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id
EBAY_AFFILIATE_CAMPAIGN_ID=5338000000

# -----------------------------------------------
# 4. Push & Email Notifications
# -----------------------------------------------
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

MAILERLITE_API_KEY=your-mailerlite-api-key

# -----------------------------------------------
# 5. Upstash Redis (Cache & Rate Limiting)
# -----------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------
# 6. Analytics & Observability
# -----------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

SENTRY_DSN=https://your-sentry-dsn@ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@ingest.sentry.io/0

# -----------------------------------------------
# 7. Trigger.dev Background Execution
# -----------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key
