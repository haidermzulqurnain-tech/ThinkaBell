# ===============================================
# ThinkaBell Environment Configuration Template
# Duplicate this file to .env.local for apps/web
# and .env for apps/jobs
# ===============================================

NODE_ENV=development
PORT=3000

# Application URL
NEXT_PUBLIC_APP_URL=https://thinkabell.click

# -----------------------------------------------
# 1. Supabase (Database & RLS)
# -----------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-facing Supabase variables for Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------
# 2. Amazon Product Advertising API (PA-API 5.0)
# -----------------------------------------------
AMAZON_ACCESS_KEY=your-amazon-access-key
AMAZON_SECRET_KEY=your-amazon-secret-key
# Partner tags are required for affiliate link generation.
# Affiliate links fail closed (error) when the tag for the
# requested marketplace is empty — no placeholder tags.
AMAZON_PARTNER_TAG=
AMAZON_PARTNER_TAG_UK=
AMAZON_PARTNER_TAG_DE=
AMAZON_PARTNER_TAG_CA=
AMAZON_REGION=us-east-1

# -----------------------------------------------
# 3. eBay Browse API
# -----------------------------------------------
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id
EBAY_AFFILIATE_CAMPAIGN_ID=5338000000

# Site-wide affiliate attribution label (eBay customid, direct-link ref).
# utm_source is derived from NEXT_PUBLIC_APP_URL automatically.
AFFILIATE_ATTRIBUTION_ID=thinkabell

# -----------------------------------------------
# 4. Push & Email Notifications
# -----------------------------------------------
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@thinkabell.click
BREVO_SENDER_NAME=ThinkaBell

# Contact form recipient (optional — falls back to BREVO_SENDER_EMAIL)
CONTACT_EMAIL=your-contact-email@example.com

# -----------------------------------------------
# 5. Upstash Redis (Cache & Rate Limiting)
# -----------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------
# 6. Analytics & Observability
# -----------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

SENTRY_DSN=https://your-sentry-dsn@ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@ingest.sentry.io/0

# Optional: Sentry trace sampling rate (0.0-1.0, defaults to 0.1)
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------
# 7. Vercel Cron / Job Security
# -----------------------------------------------
# Bearer token for securing /api/cron/* endpoints.
# Set the same value in Vercel Cron headers or as an environment secret.
CRON_SECRET=your-cron-secret-key

# API key required by public client-facing routes (/api/alerts, /api/contact)
ALERTS_API_KEY=your-alerts-api-key

# Bearer token for POST /api/revalidate (ISR cache purge). Fail-closed when unset.
REVALIDATION_SECRET=your-revalidation-secret

# Bearer token for POST /api/retailer-links (admin retailer-link writes). Fail-closed when unset.
RETAILER_LINKS_API_KEY=your-retailer-links-api-key

# -----------------------------------------------
# 8. SaaS / Software Affiliate Networks
# -----------------------------------------------
WALMART_API_KEY=your-walmart-api-key
WALMART_AFFILIATE_ID=your-walmart-affiliate-id
WALMART_AFFILIATE_TRACK_ID=your-walmart-track-id

PARTNERSTACK_API_KEY=your-partnerstack-api-key
APPSUMO_API_KEY=your-appsumo-api-key
IMPACT_API_KEY=your-impact-api-key
IMPACT_ACCOUNT_ID=your-impact-account-id

# -----------------------------------------------
# 9. Product Discovery Automation
# -----------------------------------------------
# JSON array for the discovery job. Supported source names:
# ebay, walmart, partnerstack, appsumo, impact.
# type: "physical" or "software". queries: search terms to run per source.
# Leave empty to disable discovery.
# Example:
# DISCOVERY_SOURCES=[{"name":"ebay","type":"software","queries":["project management saas"],"enabled":true}]
DISCOVERY_SOURCES=

# -----------------------------------------------
# 10. PII Field Encryption (opt-in)
# -----------------------------------------------
# 64-character hex key encoding 32 bytes. Leave unset to keep field
# encryption disabled (values stored in plaintext).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Keyed HMAC-SHA256 blind index for PII lookups (subscribers.email_hash).
# Must be a separate 64-character hex key. Leave unset only in development
# (falls back to lower-case email indexing, which is NOT a security control).
# Generate with: openssl rand -hex 32
BLIND_INDEX_KEY=

# -----------------------------------------------
# 12. Amazon Product Hunting (manual list curation)
# -----------------------------------------------
# No API and no Amazon login credentials are used or stored.
# Curate public Amazon Lists manually in your own Amazon account,
# then paste the public list URLs below. The product-discovery
# job harvests the public list pages and generates affiliate
# links from the regional partner tags above.
# Example:
# AMAZON_LIST_URLS=[{"url":"https://www.amazon.com/hz/wishlist/ls/EXAMPLE","marketplace":"US"}]
AMAZON_LIST_URLS=
# Default marketplace for list items without an explicit one
AMAZON_LIST_MARKETPLACE=US
# Maximum items harvested per list
AMAZON_LIST_MAX_ITEMS=100
# Delay in ms between consecutive list fetches (polite rate limiting)
AMAZON_LIST_FETCH_DELAY_MS=1000

# Edge proxy trust (anti-spoofing control). When "true", the
# origin honors the x-thinkabell-country header injected by
# the Cloudflare edge-worker proxy. Keep "false" on direct
# deployments (e.g. Hostinger without the worker) where the
# header is client-controllable. Never used for authorization.
EDGE_PROXY_TRUSTED=false

# -----------------------------------------------
# 11. Cloudflare Edge Worker (packages/edge-worker)
# -----------------------------------------------
# These are Worker secrets, set via: wrangler secret put <NAME>
# The worker fails closed (5xx) when any of them is unset.

# Hostinger origin base URL the worker proxies traffic to
# ORIGIN_URL=https://thinkabell.click

# Amazon affiliate tags per region
# AMAZON_US_TAG=thinkabell-20
# AMAZON_GB_TAG=thinkabell-uk-21
# AMAZON_DE_TAG=thinkabell-de-21
# AMAZON_CA_TAG=thinkabell-ca-20

# Optional fallback country when Cloudflare provides none (default: US)
# DEFAULT_COUNTRY=US

# -----------------------------------------------
# 13. Exchange Rates (price normalization)
# -----------------------------------------------
# Free, key-less FX API returning units-per-USD rates.
# Rates are cached in Redis for 1 hour; static fallback
# rates apply only when the API is unreachable.
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest
