# ===============================================
# ThinkaBell Environment Configuration Template
# Duplicate this file to .env.local for apps/web
# and .env for apps/jobs
# ===============================================

# Runtime mode for local development and tooling. Deliberately commented rather
# than set: `production` here would make local scripts behave like production,
# and `development` would make `next start` run in dev mode — which warns and
# enables dev code paths. The deployed app is always started by
# apps/web/hostinger-server.js, which normalizes this to `production`, so the
# host's value cannot leave the app in development mode.
# NODE_ENV=development
PORT=3000

# Application URL
NEXT_PUBLIC_APP_URL=https://thinkabell.click

# -----------------------------------------------
# 1. Supabase (Database & RLS)
# -----------------------------------------------
# Leave these EMPTY until a real project exists. Empty means "not configured"
# and the database client fails closed with a named error.
#
# Do NOT paste an example or placeholder value here. `https://your-project
# .supabase.co` is a syntactically valid URL, so it passes a simple presence
# check while pointing the client at a host that does not exist — Supabase
# then shows no connections at all, which looks identical to a broken
# integration. These values are validated for shape, and a malformed one is
# reported by variable name in /api/health and the startup log.
#
# Copy the URL and keys from Supabase → Project Settings → API (Data API).
# The anon key is a JWT or an sb_publishable_… key; the service-role key is a
# JWT or an sb_secret_… key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-facing Supabase variables for Next.js (same values as above).
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# they must be present for the build step as well as the runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection string (admin credential).
# Supabase Dashboard → Project Settings → Database → Connection string.
# Used ONLY by maintenance scripts (pnpm db:apply) to run DDL —
# the app itself never needs it. Set it in your local .env or a
# CI secret, never on the application host.
# SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
# Set to "1" only if the project's TLS certificate is not
# publicly signed (older projects); verified TLS is the default.
# SUPABASE_DB_SKIP_TLS_VERIFY=1

# -----------------------------------------------
# 2. Amazon Product Advertising API (PA-API 5.0)
# -----------------------------------------------
AMAZON_ACCESS_KEY=your-amazon-access-key
AMAZON_SECRET_KEY=your-amazon-secret-key
# Partner tags are required for affiliate link generation.
# Affiliate links fail closed (error) when the tag for the
# requested marketplace is empty — no placeholder tags.
AMAZON_PARTNER_TAG=
AMAZON_PARTNER_TAG_UK=
AMAZON_PARTNER_TAG_DE=
AMAZON_PARTNER_TAG_CA=
AMAZON_REGION=us-east-1

# -----------------------------------------------
# 3. eBay Browse API
# -----------------------------------------------
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id
EBAY_AFFILIATE_CAMPAIGN_ID=5338000000

# Site-wide affiliate attribution label (eBay customid, direct-link ref).
# utm_source is derived from NEXT_PUBLIC_APP_URL automatically.
AFFILIATE_ATTRIBUTION_ID=thinkabell

# -----------------------------------------------
# 4. Push & Email Notifications
# -----------------------------------------------
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@thinkabell.click
BREVO_SENDER_NAME=ThinkaBell

# Contact form recipient (optional — falls back to BREVO_SENDER_EMAIL)
CONTACT_EMAIL=your-contact-email@example.com

# -----------------------------------------------
# 5. Upstash Redis (Cache & Rate Limiting)
# -----------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------
# 6. Analytics & Observability
# -----------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Error reporting (Sentry). Leave BOTH empty until a project exists — an empty
# value means "not configured" and Sentry is never initialized.
# Copy the DSN from Sentry → Project Settings → Client Keys (DSN).
# A value that is present but malformed is reported as an env issue and Sentry
# is skipped, so never paste an example or placeholder DSN here.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional: site-ownership verification meta tags, rendered in <head>.
# Comma-separated name=value pairs. Each meta is emitted with BOTH `content`
# and `value` attributes, because impact.com verifies via `value=` while other
# providers (e.g. Google Search Console) read `content=` — so one variable covers
# any provider, and adding one is a change to the variable, not to the code.
# Example:
#   impact-site-verification=6b454876-bab0-4187-870e-2435736fd18f
NEXT_PUBLIC_SITE_VERIFICATIONS=

# Optional: Sentry trace sampling rate (0.0-1.0, defaults to 0.1)
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-time source-map upload. All three are needed together; without them the
# build still succeeds but ships minified stack frames. NOT needed at runtime,
# so they do not belong in the Hostinger Environment section — keep them in CI
# secrets or a local .env. Create the auth token at
# Sentry → Settings → Auth Tokens (scopes: project:releases, project:write, org:read).
# Full walkthrough: docs/SENTRY_SETUP.md
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------
# 7. Vercel Cron / Job Security
# -----------------------------------------------
# Bearer token for securing /api/cron/* endpoints.
# Set the same value in Vercel Cron headers or as an environment secret.
CRON_SECRET=your-cron-secret-key

# Cron schedule settings (both rows are read by the pg_cron jobs created by
# packages/database/migrations/0001_cron_schedule.sql via `pnpm db:apply`):
#   insert into public.cron_settings (key, value) values
#     ('site_url', 'https://thinkabell.click'),   -- public origin the cron endpoints run on
#     ('cron_secret', 'your-cron-secret-key')    -- MUST equal CRON_SECRET above
#     on conflict (key) do update set value = excluded.value, updated_at = now();
# These are database rows, not app environment variables: only the postgres role
# can read them. Never commit a real cron secret.

# API key required by the /api/alerts route.
# (The /api/contact route is secured with CSRF tokens + rate limiting instead.)
ALERTS_API_KEY=your-alerts-api-key

# Bearer token for POST /api/revalidate (ISR cache purge). Fail-closed when unset.
REVALIDATION_SECRET=your-revalidation-secret

# Bearer token for POST /api/retailer-links (admin retailer-link writes). Fail-closed when unset.
RETAILER_LINKS_API_KEY=your-retailer-links-api-key

# -----------------------------------------------
# 8. SaaS / Software Affiliate Networks
# -----------------------------------------------
WALMART_API_KEY=your-walmart-api-key
WALMART_AFFILIATE_ID=your-walmart-affiliate-id
WALMART_AFFILIATE_TRACK_ID=your-walmart-track-id

PARTNERSTACK_API_KEY=your-partnerstack-api-key
# Impact REST API: HTTP Basic auth — Account SID
# (username) and Auth Token (password) from
# impact.com → user settings → API.
IMPACT_ACCOUNT_SID=your-impact-account-sid
IMPACT_AUTH_TOKEN=your-impact-auth-token
# AppSumo needs no credentials: it publishes no
# public deals API, so its discovery source
# harvests the public browse and product pages.

# -----------------------------------------------
# 9. Product Discovery Automation
# -----------------------------------------------
# JSON array for the discovery job. Supported source names:
# ebay, walmart, partnerstack, appsumo, impact, amazon-list.
# type: "physical" or "software". queries: search terms to run per source.
# Leave empty to disable discovery.
# Example:
# DISCOVERY_SOURCES=[{"name":"ebay","type":"software","queries":["project management saas"],"enabled":true}]
DISCOVERY_SOURCES=

# -----------------------------------------------
# 10. PII Field Encryption (opt-in)
# -----------------------------------------------
# 64-character hex key encoding 32 bytes. Leave unset to keep field
# encryption disabled (values stored in plaintext).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Keyed HMAC-SHA256 blind index for PII lookups (subscribers.email_hash).
# Must be a separate 64-character hex key. Leave unset only in development
# (falls back to lower-case email indexing, which is NOT a security control).
# Generate with: openssl rand -hex 32
BLIND_INDEX_KEY=

# -----------------------------------------------
# 12. Amazon Product Hunting (manual list curation)
# -----------------------------------------------
# No API and no Amazon login credentials are used or stored.
# Curate public Amazon Lists manually in your own Amazon account,
# then paste the public list URLs below. The product-discovery
# job harvests the public list pages and generates affiliate
# links from the regional partner tags above.
# Example:
# AMAZON_LIST_URLS=[{"url":"https://www.amazon.com/hz/wishlist/ls/EXAMPLE","marketplace":"US"}]
AMAZON_LIST_URLS=
# Default marketplace for list items without an explicit one
AMAZON_LIST_MARKETPLACE=US
# Maximum items harvested per list
AMAZON_LIST_MAX_ITEMS=100
# Delay in ms between consecutive list fetches (polite rate limiting)
AMAZON_LIST_FETCH_DELAY_MS=1000

# Edge proxy trust (anti-spoofing control). When "true", the
# origin honors the x-thinkabell-country header injected by
# the Cloudflare edge-worker proxy. Keep "false" on direct
# deployments (e.g. Hostinger without the worker) where the
# header is client-controllable. Never used for authorization.
EDGE_PROXY_TRUSTED=false

# -----------------------------------------------
# 11. Cloudflare Edge Worker (packages/edge-worker)
# -----------------------------------------------
# These are Worker secrets, set via: wrangler secret put <NAME>
# The worker fails closed (5xx) when any of them is unset.

# Hostinger origin base URL the worker proxies traffic to
# ORIGIN_URL=https://thinkabell.click

# Amazon affiliate tags per region
# AMAZON_US_TAG=thinkabell-20
# AMAZON_GB_TAG=thinkabell-uk-21
# AMAZON_DE_TAG=thinkabell-de-21
# AMAZON_CA_TAG=thinkabell-ca-20

# Optional fallback country when Cloudflare provides none (default: US)
# DEFAULT_COUNTRY=US

# -----------------------------------------------
# 13. Exchange Rates (price normalization)
# -----------------------------------------------
# Free, key-less FX API returning units-per-USD rates.
# Rates are cached in Redis for 1 hour; static fallback
# rates apply only when the API is unreachable.
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest
